# sandbox is per-candidate scratch (roadmap §1.4/§3.4): the directory exists, its
# contents are wiped per candidate and never versioned.
sandbox/*
!sandbox/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo

# Local-only Claude Code settings
.claude/settings.local.json

# graphify volatile rebuild metadata (mtime/hash bookkeeping, regenerated by the
# post-commit hook on every commit — tracking it creates an infinite dirty-tree
# cycle). The SEMANTIC outputs (graph.json, GRAPH_REPORT.md, graph.html, labels)
# stay committed per roadmap Step 0.1.7; choice recorded in
# logs/env/STEP_0.1.7_agent_tooling.log §9.
graphify-out/cache/
graphify-out/manifest.json

# Phase-P pilot/fleet large binaries — the .so's (~330MB/kernel), cythonize .c cache, and golden
# output arrays (up to ~31MB) are regenerable from the committed source+spec+config_id; the
# decision-grade artifacts (table.jsonl, class_record.json, oracle.json, endpoint.json,
# suspicious.json, build_manifest.jsonl, spec.json, driver.py, kernel.pyx) ARE committed.
results/pilot/**/_so/
results/pilot/**/_ccache/
results/pilot/**/golden.npy
results/probes/**/_so/
results/probes/**/_ccache/
results/probes/**/golden.npy
results/fleet/**/_so/
results/fleet/**/_ccache/
results/fleet/**/golden.npy
results/fleet/**/pkg_*/

# cytune v0 smoke: reproducible build caches (D12 disk discipline)
results/cli_v0/**/_so/
results/cli_v0/**/_ccache/
results/cli_v0/**/golden.npy
graphify-out/
graphify-out/
results/

.venv/
*.egg-info/
.cytune/
