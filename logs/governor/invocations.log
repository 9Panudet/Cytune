import numpy as np, importlib.util, statistics, time, json
from scipy.sparse import random as sprand, csr_matrix
n,nf,dens,seed=1_000_000,200,0.05,20260625
# (1) scipy.sparse.random reference
Xs=sprand(n,nf,density=dens,format="csr",dtype=np.float64,random_state=seed)
rng=np.random.default_rng(seed); Xs.data[:]=rng.standard_normal(Xs.nnz)
# (2) fast O(nnz) builder (the committed recipe)
rng2=np.random.default_rng(seed); npr=round(nf*dens); nnz=n*npr
data=rng2.standard_normal(nnz); idx=rng2.integers(0,nf,size=nnz,dtype=np.int32)
indptr=np.arange(0,nnz+1,npr,dtype=np.int32)
Xf=csr_matrix((data,idx,indptr),shape=(n,nf))
w=rng2.uniform(0.5,2.0,n)
# sparsity stats
rc_s=np.diff(Xs.indptr); rc_f=np.diff(Xf.indptr)
print("nnz: scipy=%d fast=%d  nrows=%d/%d"%(Xs.nnz,Xf.nnz,Xs.shape[0],Xf.shape[0]))
print("per-row nnz: scipy mean=%.3f std=%.3f | fast mean=%.3f std=%.3f"%(rc_s.mean(),rc_s.std(),rc_f.mean(),rc_f.std()))
print("col-id uniform: scipy minmax=(%d,%d) | fast minmax=(%d,%d)"%(Xs.indices.min(),Xs.indices.max(),Xf.indices.min(),Xf.indices.max()))
# (3) time the kernel on each
spec=importlib.util.spec_from_file_location("sparsefuncs_fast","/so/golden/sparsefuncs_fast.so")
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); fn=m.csr_mean_variance_axis0
def t(X,wt):
    for _ in range(3): fn(X,wt)
    s=[]
    for _ in range(9):
        t0=time.perf_counter_ns(); fn(X,wt); s.append(time.perf_counter_ns()-t0)
    return statistics.median(s)/1e6
ts=t(Xs,w); tf=t(Xf,w)
print("kernel per-call: scipy-CSR=%.2fms  fast-CSR=%.2fms  ratio=%.4f (timing-equivalent if ~1.0)"%(ts,tf,tf/ts))
]
