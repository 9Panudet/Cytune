from scipy.sparse import random as sprand, csr_matrix
n,nf,dens,seed=1_000_000,200,0.05,20260625
spec=importlib.util.spec_from_file_location("sparsefuncs_fast","/so/golden/sparsefuncs_fast.so")
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); fn=m.csr_mean_variance_axis0
rng=np.random.default_rng(seed); w=rng.uniform(0.5,2.0,n)
def t(X):
    for _ in range(3): fn(X,w)
    s=[time.perf_counter_ns() for _ in range(1)]; s=[]
    for _ in range(9):
        t0=time.perf_counter_ns(); fn(X,w); s.append(time.perf_counter_ns()-t0)
    return statistics.median(s)/1e6
# scipy reference
Xs=sprand(n,nf,density=dens,format="csr",dtype=np.float64,random_state=seed); Xs.data[:]=rng.standard_normal(Xs.nnz)
# variant A: fixed-count unsorted-dup (current committed builder)
npr=round(nf*dens); nnz=n*npr; r2=np.random.default_rng(seed)
dA=r2.standard_normal(nnz); iA=r2.integers(0,nf,size=nnz,dtype=np.int32); ip=np.arange(0,nnz+1,npr,dtype=np.int32)
XA=csr_matrix((dA,iA.copy(),ip),shape=(n,nf))
# variant B: fixed-count SORTED-within-row (vectorized sort)
iB=np.sort(iA.reshape(n,npr),axis=1).ravel().astype(np.int32)
XB=csr_matrix((dA,iB,ip),shape=(n,nf))
print("scipy=%.2fms  fixedUnsorted(A)=%.2fms ratioA=%.4f  fixedSorted(B)=%.2fms ratioB=%.4f"%(
    t(Xs), t(XA), t(XA)/t(Xs), t(XB), t(XB)/t(Xs)))
]
