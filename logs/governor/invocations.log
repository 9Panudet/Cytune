2026-06-26T04:54:55Z RUN-START PASS no_turbo=1 gov_cpu3=performance cpu7_online=1 isolated=3,7 freq_cpu3_khz=3600000 thp=madvise argv=[-v ./src:/src:ro,Z -v ./scripts:/probe:ro,Z -v ./sandbox/corpus_so:/so:ro,Z -e PYTHONPATH=/src -e PYTHONDONTWRITEBYTECODE=1 localhost/motifbo-env:phase1 python3 -c 
import importlib.util, sys, time, hashlib, numpy as np
sys.path.insert(0,"/probe/corpus")
import sklearn.cluster                                  # loader pre-import (the _child fix)
import corpus_drivers as cd
s=importlib.util.spec_from_file_location("_k_means_lloyd","/so/_k_means_lloyd/golden/_k_means_lloyd.so")
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
fn=m.lloyd_iter_chunked_dense
ns={}; exec(cd.UNITS["lloyd_iter_chunked_dense"]["setup"]({"n_samples":200000,"n_features":50,"n_clusters":50}), ns)
args=tuple(ns["args"]); oi=cd.UNITS["lloyd_iter_chunked_dense"]["out_arg_indices"]
def oh():
    h=hashlib.sha256()
    for i in oi:
        a=np.ascontiguousarray(args[i]); h.update(str(a.dtype).encode()); h.update(a.tobytes())
    return h.hexdigest()[:16]
for _ in range(3): fn(*args)            # warmup
ts=[]; hs=[]
for _ in range(3):
    t0=time.perf_counter_ns(); fn(*args); ts.append((time.perf_counter_ns()-t0)/1e6); hs.append(oh())
print("call_times_ms=",[round(t,2) for t in ts]," ratio2/1=",round(ts[1]/ts[0],3))
print("output_hashes=",hs," identical=",len(set(hs))==1)
print("RE-CALLABLE (timed):", (len(set(hs))==1) and (ts[1]/ts[0]>0.5))
]
