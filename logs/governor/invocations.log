n,nf,dens,seed=1_000_000,200,0.05,20260625
spec=importlib.util.spec_from_file_location("sparsefuncs_fast","/so/golden/sparsefuncs_fast.so")
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); fn=m.csr_mean_variance_axis0
rng=np.random.default_rng(seed); w=rng.uniform(0.5,2.0,n)
def t(X):
    for _ in range(3): fn(X,w)
    s=[]
    for _ in range(9):
        t0=time.perf_counter_ns(); fn(X,w); s.append(time.perf_counter_ns()-t0)
    return statistics.median(s)/1e6
Xs=sprand(n,nf,density=dens,format="csr",dtype=np.float64,random_state=seed); Xs.data[:]=rng.standard_normal(Xs.nnz)
# variant C: BINOMIAL per-row counts (matches scipy density model), sorted-unique-ish columns
r=np.random.default_rng(seed)
counts=r.binomial(nf,dens,size=n).astype(np.int32)
indptr=np.zeros(n+1,dtype=np.int32); np.cumsum(counts,out=indptr[1:]); nnz=int(indptr[-1])
data=r.standard_normal(nnz); idx=r.integers(0,nf,size=nnz,dtype=np.int32)
XC=csr_matrix((data,idx,indptr),shape=(n,nf))
rcS=np.diff(Xs.indptr); rcC=np.diff(XC.indptr)
print("per-row nnz std: scipy=%.3f  variantC=%.3f"%(rcS.std(),rcC.std()))
print("nnz: scipy=%d  variantC=%d"%(Xs.nnz,XC.nnz))
print("scipy=%.2fms  variantC(binomial)=%.2fms ratioC=%.4f"%(t(Xs),t(XC),t(XC)/t(Xs)))
]
