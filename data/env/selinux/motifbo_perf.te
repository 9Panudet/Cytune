# Motif+BO Step 0.2.3 — scoped SELinux module for the perf cycle cross-check (§5.1).
#
# Evidence (logs/env/STEP_0.2.3_perf_feasibility.log): Fedora 44 policy denies the
# perf_event class to container_t — kernel AVC:
#   avc: denied { open } scontext=...container_t tcontext=...container_t
#        tclass=perf_event permissive=0
# This module allows container_t to open/read self perf counting events ONLY
# (source == target == container_t). SELinux stays Enforcing; nothing else changes.
# Install: sudo bash scripts/host_perf_prep.sh   Remove: sudo semodule -r motifbo_perf
# NOTE: persists across reboots (unlike the volatile host_prep.sh settings).

module motifbo_perf 1.0;

require {
    type container_t;
    class perf_event { open cpu kernel read write };
}

allow container_t container_t:perf_event { open cpu kernel read write };
