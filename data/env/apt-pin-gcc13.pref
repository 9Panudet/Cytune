# Motif+BO Step 0.1.2 — apt version pin for GCC 13.x (roadmap §1.3).
# Priority 1001: binding for every later apt operation in the image (downgrades included).
# Scope: the binary packages built from src:gcc-13 only. Runtime libs (libgcc-s1,
# libasan8, libubsan1, libstdc++6, ...) intentionally NOT pinned here — in Ubuntu 24.04
# they are built from src:gcc-14 (newest-GCC-builds-the-runtimes policy) and are only
# recorded + asserted via TOOLCHAIN.lock / scripts/check_toolchain.sh.

Package: gcc-13 cpp-13 gcc-13-base libgcc-13-dev gcc-13-x86-64-linux-gnu cpp-13-x86-64-linux-gnu
Pin: version 13.3.0-6ubuntu2~24.04.1
Pin-Priority: 1001

# Meta package (src:gcc-defaults): provides /usr/bin/gcc -> gcc-13.
Package: gcc
Pin: version 4:13.2.0-7ubuntu1
Pin-Priority: 1001
