#!/usr/bin/env bash
# Pre-commit hook (Step 0.1.4, roadmap §1.4: "no loose files in root").
# Rejects any staged file at repo-root depth 0 that is not on the explicit allowlist.
# Adding a new root file is a deliberate act: extend ALLOW here, in a reviewed commit.
# Source of truth: scripts/hooks/pre-commit — reinstall after edits with:
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail

# v2.0 goal change (PRODUCT_ROADMAP.md §0.1): PRODUCT_ROADMAP.md is the single root law file.
# Motif+BO-Roadmap.md (v1) is removed from the tree; its normative text stays addressable at
# `git show v1-final:Motif+BO-Roadmap.md` (tag v1-final = the Phase-1 closeout commit).
# README.md added 2026-07-30 for the v1.0-rc research-preview quickstart. Root is the
# conventional place a user looks first, and the file's whole job is to be found before
# anyone runs the tool — burying it under docs/ would defeat that.
ALLOW='^(CLAUDE\.md|PRODUCT_ROADMAP\.md|README\.md|Containerfile|\.containerignore|\.gitignore)$'

viol=0
while IFS= read -r path; do
  case "$path" in
    */*) ;;  # nested path — allowed; only root depth is policed
    *)
      if ! grep -qE "$ALLOW" <<<"$path"; then
        echo "pre-commit: REJECTED loose root file: '$path' (allowlist: scripts/hooks/pre-commit)"
        viol=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACR)

exit "$viol"
